<!DOCTYPE html>
<html>
<head>
<title>Manajemen Persediaan</title>
<link rel="stylesheet" href="/style.css">
</head>

<body class="page-layout">

<div class="main-container">

<header class="main-header">
<div>
<h2>MANAJEMEN PERSEDIAAN</h2>
<small>Role: <b style="color:#667eea;"><%= role.toUpperCase() %></b></small>
</div>

<div>
Halo <b><%= user %></b> |
<a href="/logout">Logout</a>
</div>

</header>

<form action="/tambah" method="POST" class="form-input">

<input type="text" name="nama_makanan" placeholder="Nama Makanan" required>

<input type="number" name="stok" placeholder="Stok" required>

<input type="number" name="harga" placeholder="Harga" required>

<button type="submit">Simpan</button>

</form>

<h3>DATA PERSEDIAAN MAKANAN</h3>

<table class="styled-table">

<tr>
<th>NAMA MAKANAN</th>
<th>STOK</th>
<th>HARGA</th>

<% if(role === 'admin'){ %>
<th>AKSI</th>
<% } %>

</tr>

<% makanan.forEach(item => { %>

<tr>

<td><%= item.nama_makanan %></td>

<td><%= item.stok %></td>

<td><%= item.harga %></td>

<% if(role === 'admin'){ %>

<td>
<a href="/hapus/<%= item.id %>" onclick="return confirm('Hapus?')">Hapus</a>
</td>

<% } %>

</tr>

<% }) %>

</table>

</div>

</body>
</html>